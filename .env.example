# ClinicPulse — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API

# The public project URL — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# The anon/publishable key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# The service role secret key — SERVER ONLY, never use NEXT_PUBLIC_ prefix
# Used for admin operations that bypass Row Level Security
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ─── DO NOT ADD ───────────────────────────────────────────────────────────────
# Supabase Management API Personal Access Tokens (sbp_*) have NO runtime use
# in this application and must NEVER be placed here.  They grant full project
# management rights (deletion, key rotation, config changes) via the Management
# API and should be stored exclusively in a dedicated secrets manager or the
# Supabase CLI config (~/.supabase/config.toml).
